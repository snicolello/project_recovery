{
  "manifest_version": "0.1",
  "name": "fixture-vault",
  "description": "Manifest for the synthetic fixture vault (Atlas and Beacon). Paths are relative to this file; source locators are relative to the vault root.",
  "vault": {
    "root": "../fixtures/synthetic-vault"
  },
  "index": {
    "engine": "qmd",
    "version": "2.8.3",
    "search": {"type": "lex", "rerank": false, "limit": 10},
    "embeddings": false
  },
  "budget": {
    "max_tokens": 4000,
    "tokenizer": "approx-utf8-bytes-div-2.9"
  },
  "authority_policy": {
    "local_claims": "decision_candidates",
    "verifier": {"transport": "offline", "serial": true, "snapshot_dir": "../fixtures/github-snapshots"},
    "acceptance_records": [
      {"kind": "pull_merge", "rule": "a merged pull request; bound to a decision per authority.verify_decision", "body_marker": "ACCEPTED:"},
      {"kind": "pull_review", "rule": "an approving pull request review; bound to a decision per authority.verify_decision", "body_marker": "ACCEPTED:"},
      {"kind": "issue_comment", "rule": "an issue comment; bound to a decision per authority.verify_decision", "body_marker": "ACCEPTED:"}
    ],
    "repositories": [
      {"host": "github.example.test", "repo": "portfolio/atlas", "projects": ["atlas"], "approvers": ["fixture-owner"]}
    ],
    "reference": {"frontmatter_key": "acceptance_record", "body_labels": ["Authority fixture:"]},
    "binding": {"frontmatter_key": "source_revision", "record_field": "subject_revision"},
    "note": "R2, owner ruling B. A note with status accepted is a decision candidate; it is an accepted decision only when a cited acceptance record is bound to it under authority.verify_decision (the single statement of the binding rule; see SKILL.md, Authority policy). The default transport is offline, so every referenced record is unverified; --verifier snapshot reads fixed synthetic responses, --verifier gh reads live GitHub (optional)."
  },
  "projects": {
    "atlas": {
      "collection": "atlas",
      "root": "atlas",
      "baseline_note": "Project.md",
      "fields": {
        "objective": ["Objective:"],
        "current_state": ["Current state:"],
        "blockers": ["Blocker:"],
        "next_action": ["Next authorized action:", "Deployment is not authorized."],
        "accepted_decisions": ["Accepted decision:"]
      },
      "decision_statuses": ["accepted", "draft", "superseded"],
      "authority": {
        "record": "Project.md",
        "record_key": "status",
        "approver_labels": [],
        "approvals": [
          {"name": "rollout_approval", "note": "Release Checklist.md", "label": "Atlas rollout approval:"},
          {"name": "rollout_owner", "note": "Release Checklist.md", "label": "Rollout owner:"}
        ]
      }
    },
    "beacon": {
      "collection": "beacon",
      "root": "beacon",
      "baseline_note": "Project.md",
      "fields": {
        "objective": ["Objective:"],
        "current_state": ["Current state:"],
        "blockers": ["Blocker:"],
        "next_action": ["Next authorized action:"],
        "accepted_decisions": ["Accepted decision:"]
      },
      "decision_statuses": ["accepted", "draft", "superseded"],
      "authority": {
        "record": "Project.md",
        "record_key": "status",
        "approver_labels": [],
        "approvals": []
      }
    }
  }
}
